{
  "manifest_version": 3,
  "name": "Content Digest Capture",
  "version": "0.6.1",
  "description": "Save pages, feed items, selections, and pasted permalinks to Content Digest with honest results.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Save to Content Digest",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
